<view class="page-exercise">
  <!-- 分类标签 -->
  <scroll-view scroll-x class="category-tabs">
    <view
      wx:for="{{categories}}"
      wx:for-item="exercises"
      wx:for-index="key"
      wx:key="key"
      class="category-tab {{currentCategory === key ? 'active' : ''}}"
      data-category="{{key}}"
      bind:click="onSwitchCategory"
    >
      {{key}}
      <text class="category-count">({{exercises.length}})</text>
    </view>
  </scroll-view>

  <!-- 动作列表 -->
  <view class="exercise-grid">
    <view
      wx:for="{{categories[currentCategory]}}"
      wx:key="_id"
      class="exercise-item"
      data-id="{{item._id}}"
      data-name="{{item.name}}"
      data-is-custom="{{item.isCustom}}"
      bind:longpress="onDeleteExercise"
    >
      <view class="exercise-item-content">
        <text class="exercise-item-name">{{item.name}}</text>
        <text wx:if="{{item.isCustom}}" class="custom-badge">自定义</text>
      </view>
      <van-icon
        wx:if="{{item.isCustom}}"
        name="delete-o"
        size="32rpx"
        color="var(--color-danger)"
        data-id="{{item._id}}"
        data-name="{{item.name}}"
        data-is-custom="{{item.isCustom}}"
        bind:click="onDeleteExercise"
      />
    </view>
  </view>

  <!-- 空状态 -->
  <view wx:if="{{!categories[currentCategory] || categories[currentCategory].length === 0}}" class="empty-state">
    <van-empty description="该分类暂无动作" />
  </view>

  <!-- 浮动添加按钮 -->
  <view class="fab-button" bind:click="onOpenAddDialog">
    <van-icon name="plus" size="40rpx" color="#fff" />
  </view>

  <!-- 新增动作弹窗 -->
  <van-popup
    show="{{showAddDialog}}"
    position="bottom"
    round
    closeable
    bind:close="onCloseAddDialog"
  >
    <view class="add-dialog">
      <view class="dialog-title">新增动作</view>

      <van-field
        value="{{newExerciseName}}"
        placeholder="输入动作名称"
        border
        bind:change="onNameInput"
      />

      <view class="dialog-category-select">
        <text class="dialog-section-title">选择分类</text>
        <view class="dialog-categories">
          <view
            wx:for="{{categoryKeys}}"
            wx:key="*this"
            class="dialog-category-item {{selectedCategory === item ? 'active' : ''}}"
            data-category="{{item}}"
            bind:click="onSelectCategory"
          >
            {{item}}
          </view>
        </view>
      </view>

      <view class="dialog-actions">
        <van-button round block type="primary" bind:click="onConfirmAdd">确认添加</van-button>
      </view>
    </view>
  </van-popup>
</view>
