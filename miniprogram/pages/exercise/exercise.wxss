.page-exercise {
  min-height: 100vh;
}

/* 分类标签 */
.category-tabs {
  display: flex;
  white-space: nowrap;
  padding: var(--spacing-md);
  background: var(--bg-secondary);
  margin: var(--spacing-sm) var(--spacing-md);
  border-radius: var(--border-radius-lg);
}

.category-tab {
  display: inline-block;
  padding: var(--spacing-sm) var(--spacing-md);
  margin-right: var(--spacing-sm);
  font-size: 26rpx;
  color: var(--text-secondary);
  background: var(--bg-card);
  border-radius: 30rpx;
  flex-shrink: 0;
}

.category-tab.active {
  color: var(--text-primary);
  background: var(--color-primary);
}

.category-count {
  font-size: 20rpx;
  opacity: 0.7;
}

/* 动作列表 */
.exercise-grid {
  padding: 0 var(--spacing-md);
}

.exercise-item {
  display: flex;
  align-items: center;
  justify-content: space-between;
  background: var(--bg-secondary);
  border-radius: var(--border-radius-lg);
  padding: var(--spacing-md);
  margin-bottom: var(--spacing-sm);
}

.exercise-item-content {
  display: flex;
  align-items: center;
  gap: var(--spacing-sm);
}

.exercise-item-name {
  font-size: 28rpx;
  color: var(--text-primary);
}

.custom-badge {
  font-size: 20rpx;
  color: var(--color-warning);
  background: rgba(255, 165, 2, 0.12);
  padding: 2rpx 10rpx;
  border-radius: 20rpx;
}

.empty-state {
  padding-top: 100rpx;
}

/* 浮动按钮 */
.fab-button {
  position: fixed;
  right: 40rpx;
  bottom: 60rpx;
  width: 100rpx;
  height: 100rpx;
  border-radius: 50%;
  background: var(--color-primary);
  display: flex;
  align-items: center;
  justify-content: center;
  box-shadow: 0 8rpx 24rpx rgba(233, 69, 96, 0.4);
}

/* 新增弹窗 */
.add-dialog {
  padding: var(--spacing-lg);
}

.dialog-title {
  font-size: 32rpx;
  font-weight: 600;
  color: var(--text-primary);
  text-align: center;
  margin-bottom: var(--spacing-md);
}

.dialog-section-title {
  display: block;
  font-size: 26rpx;
  color: var(--text-secondary);
  margin-bottom: var(--spacing-sm);
}

.dialog-category-select {
  margin-top: var(--spacing-md);
}

.dialog-categories {
  display: flex;
  flex-wrap: wrap;
  gap: var(--spacing-sm);
}

.dialog-category-item {
  padding: var(--spacing-sm) var(--spacing-md);
  font-size: 24rpx;
  color: var(--text-secondary);
  background: var(--bg-card);
  border-radius: 30rpx;
}

.dialog-category-item.active {
  color: var(--text-primary);
  background: var(--color-primary);
}

.dialog-actions {
  margin-top: var(--spacing-lg);
  padding-top: var(--spacing-md);
  border-top: 1rpx solid var(--border-color);
}
